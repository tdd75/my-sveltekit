{
	"name": "my-sveltekit",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port 3000",
		"build": "vite build",
		"start": "node build",
		"preview": "vite preview --port 3000",
		"prepare": "husky",
		"i18n:generate": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
		"precheck": "pnpm i18n:generate",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test": "pnpm run test:unit && pnpm run test:e2e",
		"test:unit": "vitest --run",
		"test:unit:watch": "vitest",
		"test:e2e": "playwright test --pass-with-no-tests",
		"test:e2e:smoke": "playwright test --grep @smoke --pass-with-no-tests"
	},
	"devDependencies": {
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.29.2",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "^1.61.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^6.0.0",
		"@sveltejs/kit": "^3.1.0",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/forms": "^0.5.11",
		"@tailwindcss/typography": "^0.5.20",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^26.6.5",
		"@vitest/browser-playwright": "^5.0.5",
		"bits-ui": "^2.20.2",
		"clsx": "^2.1.1",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"formsnap": "^2.1.0",
		"globals": "^17.13.0",
		"husky": "^9.1.7",
		"lint-staged": "^17.6.0",
		"mdsvex": "^0.12.8",
		"playwright": "^1.64.1",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"sveltekit-superforms": "^3.0.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.1",
		"vite": "^8.3.5",
		"vite-plugin-devtools-json": "^1.1.2",
		"vitest": "^5.0.5",
		"vitest-browser-svelte": "^3.1.0"
	},
	"dependencies": {
		"@tanstack/svelte-query": "^6.3.6"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
